    "description": "Call vpp_show_version tool",
    "request": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "tools/call",
      "params": {
        "name": "vpp_show_version",
        "arguments": {
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },

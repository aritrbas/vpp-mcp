{
  "description": "Example MCP JSON-RPC requests for testing the VPP MCP server (4-tool architecture)",
  "note": "Send these via stdio to the vpp-mcp-server process",
  "1_initialize": {
    "description": "Initialize the MCP session (required first)",
    "request": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "initialize",
      "params": {
        "protocolVersion": "2024-11-05",
        "capabilities": {},
        "clientInfo": {
          "name": "test-client",
          "version": "1.0.0"
        }
      }
    }
  },
  "2_list_tools": {
    "description": "List all available tools (should return 4: list, cluster, vppctl, gobgp)",
    "request": {
      "jsonrpc": "2.0",
      "id": 2,
      "method": "tools/list",
      "params": {}
    }
  },
  "3_call_list": {
    "description": "Get comprehensive command reference",
    "request": {
      "jsonrpc": "2.0",
      "id": 3,
      "method": "tools/call",
      "params": {
        "name": "list",
        "arguments": {}
      }
    }
  },
  "4_cluster_get_pods": {
    "description": "List CalicoVPP pods",
    "request": {
      "jsonrpc": "2.0",
      "id": 4,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_pods"
        }
      }
    }
  },
  "5_cluster_get_nodes": {
    "description": "List cluster nodes",
    "request": {
      "jsonrpc": "2.0",
      "id": 5,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_nodes"
        }
      }
    }
  },
  "6_cluster_get_configmap": {
    "description": "Get calico-vpp-config ConfigMap",
    "request": {
      "jsonrpc": "2.0",
      "id": 6,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_configmap"
        }
      }
    }
  },
  "7_cluster_get_daemonset": {
    "description": "Get DaemonSet YAML",
    "request": {
      "jsonrpc": "2.0",
      "id": 7,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_daemonset",
          "resource_name": "calico-vpp-node"
        }
      }
    }
  },
  "7b_cluster_get_events": {
    "description": "Get cluster events sorted by timestamp",
    "request": {
      "jsonrpc": "2.0",
      "id": 71,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_events"
        }
      }
    }
  },
  "7c_cluster_get_deployments": {
    "description": "List deployments in namespace",
    "request": {
      "jsonrpc": "2.0",
      "id": 72,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_deployments"
        }
      }
    }
  },
  "7d_cluster_get_services": {
    "description": "List services in namespace",
    "request": {
      "jsonrpc": "2.0",
      "id": 73,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_services"
        }
      }
    }
  },
  "7e_cluster_get_endpoints": {
    "description": "Get endpoints for a service",
    "request": {
      "jsonrpc": "2.0",
      "id": 74,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_endpoints",
          "resource_name": "kubernetes"
        }
      }
    }
  },
  "7f_cluster_get_replicaset": {
    "description": "List replicasets",
    "request": {
      "jsonrpc": "2.0",
      "id": 75,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_replicaset"
        }
      }
    }
  },
  "7g_cluster_get_ippool": {
    "description": "Get Calico IPPool resources",
    "request": {
      "jsonrpc": "2.0",
      "id": 76,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_ippool"
        }
      }
    }
  },
  "7h_cluster_get_namespaces": {
    "description": "List all namespaces",
    "request": {
      "jsonrpc": "2.0",
      "id": 77,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "get_namespaces"
        }
      }
    }
  },
  "7i_cluster_top_pods": {
    "description": "Get resource usage for pods",
    "request": {
      "jsonrpc": "2.0",
      "id": 78,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "top_pods"
        }
      }
    }
  },
  "7j_cluster_top_nodes": {
    "description": "Get resource usage for nodes",
    "request": {
      "jsonrpc": "2.0",
      "id": 79,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "top_nodes"
        }
      }
    }
  },
  "7k_cluster_exec": {
    "description": "Execute read-only command in pod",
    "request": {
      "jsonrpc": "2.0",
      "id": 80,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "exec",
          "pod_name": "YOUR_POD_NAME",
          "container": "vpp",
          "resource_name": "ip a"
        }
      }
    }
  },
  "8_cluster_logs_agent": {
    "description": "Get agent container logs",
    "request": {
      "jsonrpc": "2.0",
      "id": 8,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "logs",
          "pod_name": "YOUR_POD_NAME",
          "container": "agent",
          "tail_lines": 200
        }
      }
    }
  },
  "9_cluster_logs_vpp": {
    "description": "Get vpp-manager container logs",
    "request": {
      "jsonrpc": "2.0",
      "id": 9,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "logs",
          "pod_name": "YOUR_POD_NAME",
          "container": "vpp",
          "tail_lines": 200
        }
      }
    }
  },
  "10_cluster_describe_pod": {
    "description": "Describe a CalicoVPP pod",
    "request": {
      "jsonrpc": "2.0",
      "id": 10,
      "method": "tools/call",
      "params": {
        "name": "cluster",
        "arguments": {
          "command": "describe_pod",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "11_vppctl_show_version": {
    "description": "Get VPP version (Kubernetes mode)",
    "request": {
      "jsonrpc": "2.0",
      "id": 11,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "show version",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "12_vppctl_show_int": {
    "description": "Get VPP interface information",
    "request": {
      "jsonrpc": "2.0",
      "id": 12,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "show int",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "13_vppctl_show_int_addr": {
    "description": "Get VPP interface addresses",
    "request": {
      "jsonrpc": "2.0",
      "id": 13,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "show int addr",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "14_vppctl_show_errors": {
    "description": "Get VPP error counters",
    "request": {
      "jsonrpc": "2.0",
      "id": 14,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "show errors",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "15_vppctl_show_ip_fib": {
    "description": "Get IPv4 FIB for table index 0",
    "request": {
      "jsonrpc": "2.0",
      "id": 15,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "show ip fib index 0",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "16_vppctl_show_ip_fib_prefix": {
    "description": "Lookup specific prefix in FIB",
    "request": {
      "jsonrpc": "2.0",
      "id": 16,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "show ip fib index 0 10.0.0.0/24",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "17_vppctl_show_run": {
    "description": "Get VPP runtime statistics",
    "request": {
      "jsonrpc": "2.0",
      "id": 17,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "show run",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "18_vppctl_trace_capture": {
    "description": "Capture VPP packet traces (special capture command)",
    "request": {
      "jsonrpc": "2.0",
      "id": 18,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "trace",
          "pod_name": "YOUR_POD_NAME",
          "count": 500,
          "timeout": 30,
          "interface": "virtio"
        }
      }
    }
  },
  "19_vppctl_capture_cleanup": {
    "description": "Force cleanup of all capture operations",
    "request": {
      "jsonrpc": "2.0",
      "id": 19,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "capture_cleanup",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "20_vppctl_standalone": {
    "description": "Run vppctl command in standalone mode (local VPP daemon)",
    "request": {
      "jsonrpc": "2.0",
      "id": 20,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "show version",
          "mode": "standalone"
        }
      }
    }
  },
  "21_vppctl_standalone_custom_socket": {
    "description": "Run vppctl command in standalone mode with custom socket path",
    "request": {
      "jsonrpc": "2.0",
      "id": 21,
      "method": "tools/call",
      "params": {
        "name": "vppctl",
        "arguments": {
          "command": "show int",
          "mode": "standalone",
          "sock_path": "/var/run/vpp/cli.sock"
        }
      }
    }
  },
  "22_gobgp_neighbor": {
    "description": "List all BGP peers",
    "request": {
      "jsonrpc": "2.0",
      "id": 22,
      "method": "tools/call",
      "params": {
        "name": "gobgp",
        "arguments": {
          "command": "neighbor",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "23_gobgp_global_rib_ipv4": {
    "description": "Show IPv4 BGP RIB",
    "request": {
      "jsonrpc": "2.0",
      "id": 23,
      "method": "tools/call",
      "params": {
        "name": "gobgp",
        "arguments": {
          "command": "global rib -a ipv4",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "24_gobgp_neighbor_detail": {
    "description": "Show detailed info for a specific BGP peer",
    "request": {
      "jsonrpc": "2.0",
      "id": 24,
      "method": "tools/call",
      "params": {
        "name": "gobgp",
        "arguments": {
          "command": "neighbor 192.168.1.1",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "25_gobgp_prefix_lookup": {
    "description": "Lookup a specific prefix in the BGP RIB",
    "request": {
      "jsonrpc": "2.0",
      "id": 25,
      "method": "tools/call",
      "params": {
        "name": "gobgp",
        "arguments": {
          "command": "global rib 10.0.0.0/24",
          "pod_name": "YOUR_POD_NAME"
        }
      }
    }
  },
  "usage_example": {
    "description": "How to use these requests",
    "steps": [
      "1. Replace YOUR_POD_NAME with actual VPP pod name (for Kubernetes mode)",
      "2. For standalone mode, set mode='standalone' in vppctl arguments",
      "3. Replace parameter values (IPs, prefixes) with actual values",
      "4. Send initialize request first",
      "5. Then send other requests in sequence",
      "6. Example: echo '{...json...}' | ./vpp-mcp-server"
    ]
  }
}
